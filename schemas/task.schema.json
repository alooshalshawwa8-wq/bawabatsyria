{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofoq.local/schemas/task.schema.json",
  "title": "Task Contract",
  "description": "A bounded task contract with explicit permission tier and status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "created_at",
    "task_type",
    "status",
    "permission_level",
    "requested_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "queued",
        "planned",
        "awaiting_approval",
        "approved",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "permission_level": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ],
      "description": "R0 read-only; higher levels require explicit approval policy."
    },
    "requested_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 100,
      "uniqueItems": true
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2048
      },
      "maxItems": 100
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 100
    },
    "approval_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "result_summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    }
  }
}
