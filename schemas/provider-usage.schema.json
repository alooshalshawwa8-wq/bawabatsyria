{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofoq.local/schemas/provider-usage.schema.json",
  "title": "AI Provider Usage and Free-Tier Guard Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "usage_id",
    "provider_id",
    "model_id",
    "recorded_at",
    "request_count",
    "quota_state",
    "cost_usd",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "usage_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_count": {
      "type": "integer",
      "minimum": 0
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "quota_state": {
      "enum": [
        "verified_free",
        "unverified",
        "limit_reached",
        "provider_error",
        "unknown"
      ]
    },
    "quota_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_minute": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "requests_per_day": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tokens_per_minute": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tokens_per_day": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "decision": {
      "enum": [
        "allow",
        "block",
        "awaiting_review"
      ]
    },
    "decision_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    }
  }
}
