{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofoq.local/schemas/approval.schema.json",
  "title": "Execution Approval Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "task_id",
    "operation_fingerprint",
    "approved_by",
    "approved_at",
    "expires_at",
    "permission_level",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "operation_fingerprint": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$",
      "description": "SHA-256 fingerprint of the exact approved operation and target."
    },
    "approved_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "permission_level": {
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "consumed",
        "expired",
        "revoked"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      },
      "maxItems": 100
    },
    "single_use": {
      "type": "boolean",
      "default": true
    }
  }
}\n